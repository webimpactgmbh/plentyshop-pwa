# Copy into apps/web/.env (Plentyshop PWA)
# PlentyONE shop credentials are required separately — see Plentyshop quickstart.

# --- Uptain (uptain-pwa-beta) ---

# Required when tracking is enabled — from your Uptain dashboard
NUXT_PUBLIC_UPTAIN_ID=

# 1 = load Uptain script, 0 = disabled
NUXT_PUBLIC_UPTAIN_ENABLED=0

# 1 = console debug output for data-* attributes on the script tag
NUXT_PUBLIC_UPTAIN_DEBUG_MODE=0

# Cookie bar group key (must exist in shop cookie configuration)
NUXT_PUBLIC_UPTAIN_COOKIE_GROUP=CookieBar.marketing.label

# Consent / personal data (false = off)
NUXT_PUBLIC_UPTAIN_BLOCK_COOKIES_INITIALLY=false
NUXT_PUBLIC_UPTAIN_TRANSMIT_NEWSLETTER_DATA=false
NUXT_PUBLIC_UPTAIN_TRANSMIT_CUSTOMER_DATA=false
NUXT_PUBLIC_UPTAIN_TRANSMIT_REVENUE=false

# --- Local editor only (Plentyshop) ---
# NUXT_PUBLIC_IS_PREVIEW=1
