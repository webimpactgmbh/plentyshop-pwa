{
  "name": "@uptain-gmbh/uptain-pwa",
  "version": "1.0.7",
  "description": "Uptain tracking and personalization module for PlentyONE / Plentyshop PWA (Nuxt 3)",
  "type": "module",
  "main": "./module.ts",
  "types": "./module.ts",
  "exports": {
    ".": {
      "types": "./module.ts",
      "import": "./module.ts",
      "require": "./module.ts"
    }
  },
  "files": [
    "module.ts",
    "runtime",
    "README.md",
    ".env.example"
  ],
  "keywords": [
    "nuxt",
    "nuxt-module",
    "uptain",
    "plentyshop",
    "plentyone",
    "pwa",
    "tracking"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webimpactgmbh/uptain-pwa.git"
  },
  "peerDependencies": {
    "nuxt": ">=3.0.0",
    "@plentymarkets/shop-api": ">=0.100.0",
    "@plentymarkets/shop-core": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@plentymarkets/shop-api": {
      "optional": false
    },
    "@plentymarkets/shop-core": {
      "optional": false
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/webimpactgmbh/uptain-pwa/issues"
  },
  "homepage": "https://github.com/webimpactgmbh/uptain-pwa#readme"
}
